@model List<ProductListItemViewModel>

@{
    ViewData["Title"] = "Sản phẩm";
}

<h1>Sản phẩm</h1>

<table class="table">
    <thead>
        <tr>
            <th>Tên sản phẩm</th>
            <th class="text-end">Giá</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Name</td>
                <td class="text-end">@product.PriceText</td>
            </tr>
        }
    </tbody>
</table>