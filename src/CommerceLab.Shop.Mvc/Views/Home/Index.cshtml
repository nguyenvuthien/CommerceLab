@model ProductListViewModel

@{
    ViewData["Title"] = "Sản phẩm";
}

<h1>Sản phẩm</h1>
<form asp-controller="Home" asp-action="Index" method="get" class="mb-3">

    <input type="hidden" name="page" value="1" />

    <label asp-for="Sort">Sắp xếp</label>

    <select asp-for="Sort" class="form-select mb-2">
        <option value="id">Mặc định theo ID</option>
        <option value="price_asc">Giá tăng dần</option>
        <option value="price_desc">Giá giảm dần</option>
    </select>

    <button type="submit" class="btn btn-primary">
        Áp dụng
    </button>
</form>
<table class="table">
    <thead>
        <tr>
            <th>Tên sản phẩm</th>
            <th class="text-end">Giá</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model.Items)
        {
            <tr>
                <td>
                    <a asp-controller="Home" asp-action="Details" asp-route-id="@product.Id">
                        @product.Name
                    </a>
                </td>
                <td class="text-end">@product.PriceText</td>
            </tr>
        }
    </tbody>
    @if (Model.TotalCount == 0)
    {
        <p>Chưa có sản phẩm.</p>
    }
    else
    {
        <p>
            Trang @Model.Page / @Model.TotalPages
            — Tổng cộng @Model.TotalCount sản phẩm
        </p>
    }

    
</table>
<nav aria-label="Phân trang sản phẩm">
    @if (Model.HasPreviousPage)
    {
        <a asp-controller="Home" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-sort="@Model.Sort"
           class="btn btn-outline-primary">
            Trang trước
        </a>
    }

    @if (Model.HasNextPage)
    {
        <a asp-controller="Home" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-sort="@Model.Sort"
           class="btn btn-outline-primary">
            Trang sau
        </a>
    }
</nav>